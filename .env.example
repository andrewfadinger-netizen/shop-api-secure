# Скопируйте в .env и заполните. Файл .env в git не попадает.
PORT=3000
NODE_ENV=development

# Локальный MongoDB (служба MongoDB Server на Windows)
MONGODB_URI=mongodb://127.0.0.1:27017/shop_secure_db
# Или MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shop_secure_db?retryWrites=true&w=majority

# Секрет подписи JWT — длинная случайная строка (≥ 32 символов). Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Со значением-заглушкой ниже сервер НЕ запустится.
JWT_ACCESS_SECRET=change-me-generate-a-long-random-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Стоимость bcrypt (10–12 для продакшена; чем больше, тем медленнее подбор)
BCRYPT_ROUNDS=12

# Блокировка аккаунта: после N неудачных входов — на M минут
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# Лимиты запросов с одного IP за 15 минут
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# Разрешённые источники для CORS (через запятую)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# За обратным прокси (nginx, облако) — число прокси перед приложением
# TRUST_PROXY=1
