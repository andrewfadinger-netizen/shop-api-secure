{
  "name": "shop-api-secure",
  "version": "1.0.0",
  "description": "Безопасный REST API интернет-магазина: Express + Mongoose + MongoDB, JWT-аутентификация, роли, защита маршрутов",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "smoke": "node scripts/smoke.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20.12"
  },
  "keywords": [
    "express",
    "mongoose",
    "mongodb",
    "rest-api",
    "crud",
    "jwt",
    "security"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
